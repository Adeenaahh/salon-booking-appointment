# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Atlas or Local MongoDB Connection String
# Replace with your actual MongoDB Atlas connection URI:
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/salon_booking?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/salon_booking

# JWT Secret Key for Signing Authentication Tokens
JWT_SECRET=super_secret_jwt_key_glamour_haven_2026_change_in_production

# JWT Expiration
JWT_EXPIRES_IN=24h

# Allowed Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Default Admin Credentials (Used by npm run seed)
DEFAULT_ADMIN_NAME=Salon Administrator
DEFAULT_ADMIN_EMAIL=admin@glamourhaven.com
DEFAULT_ADMIN_PASSWORD=AdminPass2026!
